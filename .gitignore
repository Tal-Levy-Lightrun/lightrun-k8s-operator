
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin
testbin/*

# Test binary, build with `go test -c`
*.test
coverage/**

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage-report.html
# Kubernetes Generated files - skip generated files, except for vendored files

!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
*.swp
*.swo
*~
.vscode
# macOS
.DS_Store

# Proprietary agent release artifacts - CI downloads these from S3 at build time
# (see .github/workflows/init_container*.yaml); never commit them to this repo.
lightrun-init-agent-node/*.zip
lightrun-init-agent/*.zip
